# Copy to .env and fill real values. NEVER commit .env.
# PROPhish configuration (security awareness simulation platform)

# Postgres password — REQUIRED by docker-compose (no default; pick a strong one).
PROPHISH_DB_PASSWORD=change_me_in_dev_only
# Postgres connection string used when running the binary directly (not via compose).
PROPHISH_DB_URL=postgres://prophish:change_me_in_dev_only@127.0.0.1:5432/prophish?sslmode=disable

# HTTP listen address for the ADMIN panel.
# Keep the admin panel behind a VPN / IP allowlist. Bind to localhost by default.
PROPHISH_ADMIN_ADDR=127.0.0.1:8443
# Host bind IP for the published ADMIN port (docker-compose only). Default
# 127.0.0.1 (localhost only — reach it via an SSH tunnel). Set to 0.0.0.0 for
# direct access from the network WITHOUT a tunnel; then restrict who may reach
# it with PROPHISH_ADMIN_ALLOW_CIDRS below.
# PROPHISH_ADMIN_BIND=0.0.0.0
# Networks allowed to open the ADMIN panel (comma-separated CIDRs). Loopback is
# always allowed; empty = no restriction. Enforced in-app on the real peer IP.
PROPHISH_ADMIN_ALLOW_CIDRS=10.30.22.0/24,10.20.51.0/24,10.20.25.223/32

# Public server that serves landing pages and receives tracking pings.
# This is the ONLY component targets talk to. Put it behind a reverse proxy with TLS.
PROPHISH_PUBLIC_ADDR=127.0.0.1:8080
# Host bind IP for the published PUBLIC port (docker-compose only). Default
# 127.0.0.1 (localhost only). Set to 0.0.0.0 to expose the public server on the
# LAN so "host" listener campaigns reach it from other machines on the network.
# Keep it off the public internet. Does NOT affect the admin panel (stays local).
# PROPHISH_PUBLIC_BIND=127.0.0.1
# The external URL the TARGETS' machines use to load the tracking pixel and the
# landing page. It is baked into every email, so it MUST be reachable from the
# RECIPIENT'S machine, not from this server. Leave it BLANK to auto-derive this
# host's own LAN address (http://<lan-ip>:8080) for "host" listener campaigns —
# and set PROPHISH_PUBLIC_BIND=0.0.0.0 above so other machines can reach it.
# A loopback/localhost value makes every tracking link point at the recipient's
# OWN machine, so opens AND clicks never register. For recipients off the LAN
# (webmail, phones, external networks) use the Cloudflare gateway listener — it
# gives each campaign a public https URL automatically; a private-IP host URL
# cannot be reached by a webmail provider's image proxy, so opens won't record.
# PROPHISH_PUBLIC_BASE_URL=

# 32-byte random key for signing session cookies (base64 or hex, keep secret).
# Generate one with:  openssl rand -base64 32
PROPHISH_SESSION_KEY=replace_with_random_32_byte_secret

# Set to "true" only when served over HTTPS (required in production).
PROPHISH_SECURE_COOKIES=false

# Operator time zone (IANA name, e.g. Asia/Baku) used for scheduling campaign
# launch times and displaying timestamps. Defaults to UTC. The tz database is
# embedded in the binary, so any IANA name works without extra packages.
PROPHISH_TIMEZONE=UTC

# Comma-separated CIDRs of trusted reverse proxies in front of the PUBLIC server.
# Only these sources' X-Forwarded-For is honored for recorded client IPs; leave
# empty to always use the direct peer address (safe default, no IP spoofing).
PROPHISH_TRUSTED_PROXIES=
