# Copy to .env and fill real values. NEVER commit .env.
# SecDrill configuration (security awareness simulation platform)

# Postgres password — REQUIRED by docker-compose (no default; pick a strong one).
SECDRILL_DB_PASSWORD=change_me_in_dev_only
# Postgres connection string used when running the binary directly (not via compose).
SECDRILL_DB_URL=postgres://secdrill:change_me_in_dev_only@127.0.0.1:5432/secdrill?sslmode=disable

# HTTP listen address for the ADMIN panel.
# Keep the admin panel behind a VPN / IP allowlist. Bind to localhost by default.
SECDRILL_ADMIN_ADDR=127.0.0.1:8443

# Public server that serves landing pages and receives tracking pings.
# This is the ONLY component targets talk to. Put it behind a reverse proxy with TLS.
SECDRILL_PUBLIC_ADDR=127.0.0.1:8080
# The external URL targets will reach (used to build tracking links in emails).
SECDRILL_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 32-byte random key for signing session cookies (base64 or hex, keep secret).
# Generate one with:  openssl rand -base64 32
SECDRILL_SESSION_KEY=replace_with_random_32_byte_secret

# Set to "true" only when served over HTTPS (required in production).
SECDRILL_SECURE_COOKIES=false

# Operator time zone (IANA name, e.g. Asia/Baku) used for scheduling campaign
# launch times and displaying timestamps. Defaults to UTC. The tz database is
# embedded in the binary, so any IANA name works without extra packages.
SECDRILL_TIMEZONE=UTC

# Comma-separated CIDRs of trusted reverse proxies in front of the PUBLIC server.
# Only these sources' X-Forwarded-For is honored for recorded client IPs; leave
# empty to always use the direct peer address (safe default, no IP spoofing).
SECDRILL_TRUSTED_PROXIES=
